{
	"luci-app-hd-idle": {
		"description": "Grant UCI access for luci-app-hd-idle",
		"read": {
			"file": {
				"/usr/bin/lsblk -n -J -do NAME,TRAN,ROTA,RM,VENDOR,MODEL": [ "exec" ]
			},
			"menu": [ "admin/nas", "admin/nas/hd_idle" ],
			"uci": [ "hd-idle" ]
		},
		"write": {
			"menu": [ "admin/nas/hd_idle" ],
			"uci": [ "hd-idle" ]
		}
	}
}
